{
  "welcomeFile": "/com.sales.orders.salesorders/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/"
  },
  "routes": [
    {
      "source": "^/orders/(.*)$",
      "target": "/orders/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/analytics/(.*)$",
      "target": "/analytics/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },  
    {
      "source": "^/com\\.sales\\.orders\\.salesorders/(.*)$",
      "target": "$1",
      "localDir": "resources/com.sales.orders.salesorders",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    }
  ]
}