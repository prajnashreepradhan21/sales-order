      <viewAttribute id="PREVIOUS_YEAR_REVENUE"/>
    </viewAttributes>
    <calculatedViewAttributes>
      <calculatedViewAttribute id="MATCH_YEAR" datatype="INTEGER" expressionLanguage="SQL">
        <formula>&quot;PREVIOUS_YEAR&quot; + 1</formula>
      </calculatedViewAttribute>
    </calculatedViewAttributes>
