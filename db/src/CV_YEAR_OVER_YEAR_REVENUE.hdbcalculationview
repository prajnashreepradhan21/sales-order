    </input>
  </calculationView>
  <calculationView xsi:type="Calculation:JoinView" id="Join_Current_Previous" cardinality="C1_1" joinType="leftOuter">
    <viewAttributes>
      <viewAttribute id="ORDER_YEAR" aggregationType="sum"/>
      <viewAttribute id="PREVIOUS_YEAR" aggregationType="sum"/>
      <viewAttribute id="CURRENCY"/>
      <viewAttribute id="CURRENT_YEAR_REVENUE" aggregationType="sum"/>
      <viewAttribute id="PREVIOUS_YEAR_REVENUE" aggregationType="sum"/>
      <viewAttribute hidden="true" id="JOIN$MATCH_YEAR$CURRENT_YEAR"/>
      <viewAttribute hidden="true" id="JOIN$PREVIOUS_CURRENCY$CURRENT_CURRENCY"/>
    </viewAttributes>
    <calculatedViewAttributes>
      <calculatedViewAttribute id="REVENUE_CHANGE" datatype="DECIMAL" length="18" scale="2" expressionLanguage="SQL">
        <formula>&quot;CURRENT_YEAR_REVENUE&quot; - IFNULL(&quot;PREVIOUS_YEAR_REVENUE&quot;, 0)</formula>
      </calculatedViewAttribute>
      <calculatedViewAttribute id="GROWTH_PERCENTAGE" datatype="DECIMAL" length="18" scale="2" expressionLanguage="SQL">
        <formula>CASE
    WHEN &quot;PREVIOUS_YEAR_REVENUE&quot; IS NULL
         OR &quot;PREVIOUS_YEAR_REVENUE&quot; = 0
    THEN 0
    ELSE
        (
            (
                &quot;CURRENT_YEAR_REVENUE&quot;
                - &quot;PREVIOUS_YEAR_REVENUE&quot;
            )
            / &quot;PREVIOUS_YEAR_REVENUE&quot;
        ) * 100
END</formula>
      </calculatedViewAttribute>
    </calculatedViewAttributes>
    <input node="Projection_Previous_Year">
      <mapping xsi:type="Calculation:AttributeMapping" target="PREVIOUS_YEAR" source="PREVIOUS_YEAR"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="PREVIOUS_YEAR_REVENUE" source="PREVIOUS_YEAR_REVENUE"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="JOIN$MATCH_YEAR$CURRENT_YEAR" source="MATCH_YEAR"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="JOIN$PREVIOUS_CURRENCY$CURRENT_CURRENCY" source="PREVIOUS_CURRENCY"/>
    </input>
    <input node="Projection_Current_Year">
      <mapping xsi:type="Calculation:AttributeMapping" target="ORDER_YEAR" source="CURRENT_YEAR"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="CURRENCY" source="CURRENT_CURRENCY"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="CURRENT_YEAR_REVENUE" source="CURRENT_YEAR_REVENUE"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="JOIN$MATCH_YEAR$CURRENT_YEAR" source="CURRENT_YEAR"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="JOIN$PREVIOUS_CURRENCY$CURRENT_CURRENCY" source="CURRENT_CURRENCY"/>
    </input>
    <joinAttribute name="JOIN$MATCH_YEAR$CURRENT_YEAR"/>
    <joinAttribute name="JOIN$PREVIOUS_CURRENCY$CURRENT_CURRENCY"/>
  </calculationView>
